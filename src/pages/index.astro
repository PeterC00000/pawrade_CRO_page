---
// Pawrade slide carousel (prototype branch). Three full-viewport, swipeable slides.
// The slide artwork has its text baked in, so each slide is shown whole ("contain") over a blurred
// copy of itself. On a 16:9 screen it fills the viewport edge to edge.
// Hotspots sit on the baked-in button and arrows (percent of the 1920x1080 artwork) to make them work.
const CONTACT = 'https://www.pawrade.com/contact/'; // TODO: confirm the contact URL

const slides = [
	{
		alt: 'A woman laughing as she hugs a fluffy white Pomeranian puppy. Headline: Checked for health. Raised for happiness. Browse puppies from reputable breeders and verified listings.',
		hotspots: [
			{ kind: 'cta', x: 3.8, y: 81.5, w: 30, h: 10.2, label: 'Contact Pawrade' },
			{ kind: 'next', x: 86, y: 79.8, w: 7.6, h: 13.5, label: 'Next slide' },
		],
	},
	{
		alt: 'A father and child walking hand in hand with a small white dog on a mountain trail. Headline: It’s easy to choose a Pawrade puppy. With full protection from scams and puppy mills, finding the perfect puppy is a click away.',
		hotspots: [
			{ kind: 'cta', x: 35, y: 65.3, w: 30, h: 10, label: 'Contact Pawrade' },
			{ kind: 'prev', x: 6.4, y: 79.8, w: 7.6, h: 13.5, label: 'Previous slide' },
			{ kind: 'next', x: 86, y: 79.8, w: 7.6, h: 13.5, label: 'Next slide' },
		],
	},
	{
		alt: 'A couple kissing a small brown poodle puppy between them. Headline: Where reputation meets adorable. With over 25,000+ reviews, our process to bring puppy love into your home is tried and true.',
		hotspots: [
			{ kind: 'cta', x: 62.4, y: 81.5, w: 30, h: 10.2, label: 'Contact Pawrade' },
			{ kind: 'prev', x: 6.4, y: 79.8, w: 7.6, h: 13.5, label: 'Previous slide' },
		],
	},
];
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Pawrade</title>
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#274553">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" as="image" href="/images/slides/slide-1-960.webp" type="image/webp" media="(max-width: 960px)">
<link rel="preload" as="image" href="/images/slides/slide-1-1920.webp" type="image/webp" media="(min-width: 961px)">
</head>
<body>

<div class="carousel" role="region" aria-roledescription="carousel" aria-label="Pawrade">
	<div class="slides" id="slides" tabindex="0" aria-label="Slides. Swipe or use the arrow keys.">
		{slides.map((s, i) => (
			<section class="slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`} data-slide={i}>
				<img class="fill" src={`/images/slides/slide-${i + 1}-960.webp`} alt="" aria-hidden="true" decoding="async" loading={i === 0 ? 'eager' : 'lazy'}>
				<div class="frame">
					<img
						class="art"
						src={`/images/slides/slide-${i + 1}-1920.webp`}
						srcset={`/images/slides/slide-${i + 1}-960.webp 960w, /images/slides/slide-${i + 1}-1920.webp 1920w`}
						sizes="min(100vw, 177.78vh)"
						width="1920" height="1080"
						alt={s.alt}
						decoding="async"
						loading={i === 0 ? 'eager' : 'lazy'}
						fetchpriority={i === 0 ? 'high' : 'auto'}
						draggable="false"
					>
					{s.hotspots.map((h) => (
						h.kind === 'cta'
							? <a class="hs" href={CONTACT} aria-label={h.label} data-track={`slide${i + 1}_contact`} style={`left:${h.x}%;top:${h.y}%;width:${h.w}%;height:${h.h}%`}></a>
							: <button class="hs hs-round" type="button" aria-label={h.label} data-go={h.kind} style={`left:${h.x}%;top:${h.y}%;width:${h.w}%;height:${h.h}%`}></button>
					))}
				</div>
			</section>
		))}
	</div>
	<div class="dots" role="tablist" aria-label="Choose a slide">
		{slides.map((_, i) => <button type="button" role="tab" aria-label={`Slide ${i + 1}`} aria-selected={i === 0 ? 'true' : 'false'} data-dot={i}></button>)}
	</div>
</div>

<script is:inline>
(function(){
  var box=document.getElementById('slides');
  var slides=[].slice.call(box.querySelectorAll('.slide'));
  var dots=[].slice.call(document.querySelectorAll('[data-dot]'));
  var n=slides.length;
  function index(){ return Math.max(0,Math.min(n-1,Math.round(box.scrollLeft/box.clientWidth))); }
  function go(i){ i=Math.max(0,Math.min(n-1,i)); box.scrollTo({left:i*box.clientWidth,behavior:'smooth'}); }
  function paint(){
    var i=index();
    dots.forEach(function(d,k){ d.setAttribute('aria-selected',k===i?'true':'false'); });
  }
  box.addEventListener('scroll',function(){ window.requestAnimationFrame(paint); },{passive:true});
  dots.forEach(function(d,k){ d.addEventListener('click',function(){ go(k); }); });
  document.querySelectorAll('[data-go]').forEach(function(b){
    b.addEventListener('click',function(){ go(index()+(b.getAttribute('data-go')==='next'?1:-1)); });
  });
  document.addEventListener('keydown',function(e){
    if(e.key==='ArrowRight'){ go(index()+1); }
    else if(e.key==='ArrowLeft'){ go(index()-1); }
  });
  window.addEventListener('resize',function(){ box.scrollTo({left:index()*box.clientWidth,behavior:'auto'}); });
})();
</script>

<style is:global>
*,*::before,*::after{box-sizing:border-box}
html,body{margin:0;height:100%;background:#1b2630;overflow:hidden}
body{font-family:system-ui,-apple-system,'Segoe UI',sans-serif;-webkit-text-size-adjust:100%}

.carousel{position:fixed;inset:0;width:100vw;height:100vh;height:100dvh}
.slides{display:flex;width:100%;height:100%;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch;scrollbar-width:none;touch-action:pan-x}
.slides::-webkit-scrollbar{display:none}
@media (prefers-reduced-motion:no-preference){.slides{scroll-behavior:smooth}}
.slides:focus-visible{outline:3px solid #00a7e1;outline-offset:-3px}

/* every slide is exactly the viewport */
.slide{position:relative;flex:0 0 100vw;width:100vw;height:100vh;height:100dvh;scroll-snap-align:start;scroll-snap-stop:always;overflow:hidden;display:grid;place-items:center;background:#1b2630}

/* blurred copy fills any letterbox space */
.slide .fill{position:absolute;inset:-6%;width:112%;height:112%;object-fit:cover;filter:blur(26px) brightness(.72) saturate(1.1);transform:scale(1.05);pointer-events:none;user-select:none}

/* the artwork: largest 16:9 box that fits the viewport */
.frame{position:relative;width:min(100vw,calc(100vh * 16 / 9));width:min(100vw,calc(100dvh * 16 / 9));aspect-ratio:16/9}
.art{display:block;width:100%;height:100%;object-fit:contain;user-select:none;-webkit-user-drag:none}

/* clickable zones over the artwork's button and arrows (each has a 44px minimum tap area) */
.hs{position:absolute;display:block;border:0;padding:0;margin:0;background:transparent;cursor:pointer;border-radius:999px;-webkit-tap-highlight-color:rgba(255,255,255,.25)}
.hs::after{content:"";position:absolute;left:50%;top:50%;width:max(100%,44px);height:max(100%,44px);transform:translate(-50%,-50%)}
.hs-round{border-radius:50%}
.hs:focus-visible{outline:3px solid #fff;outline-offset:3px;box-shadow:0 0 0 6px #00a7e1}

.dots{position:absolute;left:50%;bottom:max(14px,env(safe-area-inset-bottom));transform:translateX(-50%);display:flex;gap:10px;padding:8px 12px;border-radius:999px;background:rgba(27,38,48,.55);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
.dots button{position:relative;width:10px;height:10px;padding:0;border:0;border-radius:50%;background:rgba(255,255,255,.5);cursor:pointer;transition:background-color .2s,transform .2s}
.dots button::after{content:"";position:absolute;inset:-17px}
.dots button[aria-selected="true"]{background:#fff;transform:scale(1.25)}
@media (prefers-reduced-motion:reduce){.dots button{transition:none}}
</style>
</body>
</html>
