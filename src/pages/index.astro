import '@fontsource/open-sans/700.css';
import '@fontsource/open-sans/800.css';
import '@fontsource/caveat/700.css'; // cursive row in the H1 (requested; not one of the two brand fonts)
import '@fontsource-variable/montserrat/index.css';
import '../styles/v2.css';
import { Phone, Check, X, ArrowRight, Star, MessageCircle, MapPin, Plane, Truck } from '@lucide/astro';

const PUPPIES = 'https://www.pawrade.com/puppies'; // TODO: confirm the Available Puppies URL
const PHONE = '(888) 729-8812';

// Delivery options. Descriptions are plain-language placeholders: confirm the wording with the transport team.
const delivery = [
	{ icon: MapPin, title: 'Local Pickup', text: 'Meet your breeder and bring your puppy home yourself.' },
	{ icon: Plane, title: 'Air Travel', text: 'Your puppy flies to an airport near you.' },
	{ icon: Truck, title: 'Pampered Ground Delivery', text: 'Door-to-door ground delivery with extra care along the way.' },
];

// Map pins. x/y = position on the map image (percent). Circles (cx, cy, r in stage units) have different
// sizes and may overlap the map; lines point from each circle to its area.
const MAP = { x0: 60, y0: 110, w: 880, h: 480 };           // map box inside the 1000x700 stage
const pins = [
	{ city: 'Seattle area', img: 'pup-sheltie', alt: 'An Australian Shepherd puppy in the snow', x: 14.5, y: 9, cx: 95, cy: 120, r: 69 },
	{ city: 'Boise area', img: 'pup-pomsky', alt: 'A Pomsky puppy', x: 21, y: 26, cx: 250, cy: 60, r: 54 },
	{ city: 'Denver area', img: 'pup-goldendoodle', alt: 'A merle Mini Goldendoodle puppy', x: 35, y: 44, cx: 430, cy: 200, r: 93 },
	{ city: 'Nashville area', img: 'pup-cavapoo', alt: 'A Cavapoo puppy in a blue bandana', x: 69, y: 57, cx: 905, cy: 430, r: 75 },
	{ city: 'Chicago area', img: 'pup-poodle', alt: 'A Mini Poodle puppy', x: 61.5, y: 34, cx: 725, cy: 95, r: 63 },
	{ city: 'Upstate New York', img: 'pup-yorkie', alt: 'A Yorkshire Terrier puppy', x: 79, y: 27, cx: 880, cy: 150, r: 81 },
	{ city: 'Phoenix area', img: 'pup-chihuahua', alt: 'A tiny Chihuahua puppy held in a hand', x: 24.5, y: 66, cx: 160, cy: 520, r: 87 },
	{ city: 'Houston area', img: 'pup-shihtzu', alt: 'A Shih Tzu puppy', x: 51, y: 79, cx: 410, cy: 598, r: 96 },
	{ city: 'Miami area', img: 'pup-frenchie', alt: 'A blue French Bulldog puppy wearing pearls', x: 79, y: 91, cx: 690, cy: 615, r: 69 },
].map((p) => {
	const tx = MAP.x0 + (MAP.w * p.x) / 100, ty = MAP.y0 + (MAP.h * p.y) / 100;
	const d = Math.hypot(tx - p.cx, ty - p.cy);
	return { ...p, tx, ty, sx: p.cx + ((tx - p.cx) / d) * p.r, sy: p.cy + ((ty - p.cy) / d) * p.r };
});

const compare = [
	['No scams, full protection', 'Higher risk of scams and fraud'],
	['Quick, honest responses', 'Slower, inconsistent replies'],
	['Fully vetted breeders', 'Backyard breeders and puppy mills'],
	['Support throughout the process', 'Stuck with your gut feeling'],
];

// Ranked best seller first. `slug` = image name in public/images/breeds/. Toy Poodles: add a photo, then list it here.
const breeds = [
	{ slug: 'mini-dachshund', name: 'Mini Dachshunds', alt: 'A Mini Dachshund puppy sitting in a red wagon' },
	{ slug: 'chihuahua', name: 'Chihuahuas', alt: 'A tiny Chihuahua puppy held in a hand' },
	{ slug: 'cavalier', name: 'Cavalier King Charles Spaniels', alt: 'A Cavalier King Charles Spaniel puppy on the grass' },
	{ slug: 'yorkie', name: 'Yorkshire Terriers', alt: 'A Yorkshire Terrier puppy standing beside a plant' },
	{ slug: 'cavapoo', name: 'Cavapoos', alt: 'A Cavapoo puppy sitting on a blanket' },
	{ slug: 'french-bulldog', name: 'French Bulldogs', alt: 'A French Bulldog puppy with blue eyes' },
	{ slug: 'shih-tzu', name: 'Shih Tzus', alt: 'A brown and white Shih Tzu puppy held in a hand' },
	{ slug: 'maltipoo', name: 'Maltipoos', alt: 'A white Maltipoo puppy with a pink bow' },
	{ slug: 'mini-bernedoodle', name: 'Mini Bernedoodles', alt: 'A tricolor Mini Bernedoodle puppy' },
	{ slug: 'mini-goldendoodle', name: 'Mini Goldendoodles', alt: 'A curly Mini Goldendoodle puppy on a porch' },
	{ slug: 'golden-retriever', name: 'Golden Retrievers', alt: 'A Golden Retriever puppy' },
	{ slug: 'pomeranian', name: 'Pomeranians', alt: 'A fluffy orange Pomeranian puppy' },
	{ slug: 'havanese', name: 'Havanese', alt: 'A fluffy Havanese puppy looking at the camera' },
	{ slug: 'labrador', name: 'Labrador Retrievers', alt: 'A chocolate Labrador Retriever puppy with blue eyes' },
	{ slug: 'beagle', name: 'Beagles', alt: 'A Beagle puppy with floppy ears' },
	{ slug: 'miniature-poodle', name: 'Miniature Poodles', alt: 'A curly Miniature Poodle puppy up close' },
	{ slug: 'boston-terrier', name: 'Boston Terriers', alt: 'A Boston Terrier puppy sitting in a basket' },
	{ slug: 'boxer', name: 'Boxers', alt: 'A Boxer puppy sitting up' },
];

// Real customer reviews (from the Demand Gen assets). Quotes are the customers' own words.
const reviews = [
	{ photo: '/images/cust-stacy.webp', ph: 880, alt: 'Stacy and her husband holding their new Bichon Frise puppy', pup: 'Bichon Frise puppy', quote: 'From start to finish, they were professional, communicative, and genuinely caring. My puppy arrived happy, healthy, and right on time\u2014clearly cared for every step of the way.', who: 'Stacy M., Westford, MA' },
	{ photo: '/images/cust-malinda.webp', ph: 640, alt: 'Malinda holding her new Mini Dachshund puppy', pup: 'Mini Dachshund puppy', quote: 'The Pawrade team is incredible! They made the task of purchasing my pup a breeze. They offer financing and even travel plans for pups who might be across state lines!', who: 'Malinda C., Franklin, GA' },
	{ photo: '/images/cust-michael.webp', ph: 640, alt: 'Michael holding his new Cavalier King Charles Spaniel puppy', pup: 'Cavalier King Charles Spaniel puppy', quote: 'He is adorable!!! Just precious!!! My family immediately fell in love with him and with his playful and gentle nature and energetic interactions!!!', who: 'Michael P., Mesquite, TX' },
];

const bubbles = ['cavalier', 'pomeranian', 'mini-goldendoodle', 'french-bulldog', 'beagle', 'cavapoo'];

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{ '@type': 'Organization', name: 'Pawrade', url: 'https://www.pawrade.com', telephone: '+1-888-729-8812' },
	],
};
