.offer-card{position:absolute;z-index:2;right:clamp(24px,4.5vw,72px);bottom:clamp(36px,5.5vw,72px);width:min(300px,calc(100% - 48px));padding:20px 22px;color:#fff;background:rgba(39,50,61,.55);-webkit-backdrop-filter:blur(16px) saturate(140%);backdrop-filter:blur(16px) saturate(140%);border:1px solid rgba(255,255,255,.26);border-left:4px solid var(--orange);border-radius:var(--radius);box-shadow:0 24px 60px rgba(20,28,36,.38)}
