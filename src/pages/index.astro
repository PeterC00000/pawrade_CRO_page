<!doctype html>
<html lang="en" data-v="pmax">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Find a Healthy Puppy from a Verified Breeder | Pawrade</title>
<meta name="description" content="Find a healthy puppy from a verified breeder. No scams, no puppy mills. Health guarantee, safe delivery and a real Puppy Specialist. Save $200 for a limited time.">
<!-- PROTOTYPE: remove the robots tag below before launch if this page should be indexed. Most paid landing pages stay noindex. -->
<meta name="robots" content="noindex, nofollow">
<meta property="og:type" content="website">
<meta property="og:title" content="Find a Healthy Puppy from a Verified Breeder | Pawrade">
<meta property="og:description" content="No scams. No puppy mills. Verified breeders, a health guarantee and a real Puppy Specialist. $200 off any puppy for a limited time.">
<meta property="og:image" content="/images/hero-family.jpg">
<meta property="fb:app_id" content="436584587155125">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#007dab">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<script is:inline>
/* Hero variant from the URL: ?v=meta (emotional, family photo) or ?v=pmax (trust + $200 offer, the default).
   Runs before first paint so the right hero shows and only the matching photo is requested. */
(function(){
  var v=new URLSearchParams(location.search).get('v');
  v=(v==='meta')?'meta':'pmax';
  document.documentElement.setAttribute('data-v',v);
  window.PAWRADE_VARIANT=v;
  var l=document.createElement('link');
  l.rel='preload';l.as='image';l.type='image/webp';
  l.href=(v==='meta')?'/images/hero-family-meta.webp':'/images/hero-family.webp';
  document.head.appendChild(l);
})();
</script>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>

<body>
<a class="sr-only skip" href="#main-content">Skip to main content</a>

<div class="promo" role="region" aria-label="Current offer">
  <span class="long">Fall in love with a new best friend: <strong>$200 off the advertised price of any puppy</strong>. Limited time only. </span>
  <span class="short"><strong>Fall in Love: $200 off any puppy.</strong> Limited time. </span>
  <a href="#offer-terms">See terms</a>
</div>

<header class="top">
  <div class="wrap">
    <div class="logo"><img src="/images/logo.webp" width="454" height="91" alt="Pawrade"></div>
    <div class="rating" aria-label="Rated 5 out of 5 stars from over 26,000 reviews">
      <span class="stars" aria-hidden="true">{[0,1,2,3,4].map(() => <Star />)}</span>
      <span><b>26,000+</b> reviews</span>
    </div>
    <div class="top-actions">
      <a class="top-call" href="tel:8887298812" data-track="header_call">
        <small>Talk to a real person, 9AM–11PM EST</small>
        <strong>{PHONE}</strong>
      </a>
      <a class="btn btn-ghost btn-sm btn-call-m" href="tel:8887298812" data-track="header_call_mobile"><Phone class="i" aria-hidden="true" />Call us</a>
      <a class="btn btn-primary btn-sm btn-find" href={PUPPIES} data-track="header_find_puppy">Find My Puppy</a>
    </div>
  </div>
</header>

<main id="main-content">

<!-- ================= HERO (two variants, switched by html[data-v]) ================= -->
<section class="hero" id="top" aria-labelledby="h1">
  <div class="hero-media" role="img" aria-label="A family laughing with their new puppy">
    <div class="bg"></div>
    <div class="offer-card v-pmax">
      <div class="v">$200 off any puppy</div>
      <div class="n">Off the advertised price. Limited time only.</div>
    </div>
  </div>
  <div class="wrap hero-grid">
    <div class="hero-head">
      <h1 id="h1">
        <span class="v-pmax">Find a Healthy Puppy from a <em>Verified Breeder.</em> <span class="hand">No Scams. No Puppy Mills.</span></span>
        <span class="v-meta">Bring Home the Newest <em>Member of Your Family.</em> <span class="hand">Healthy. Happy. Yours.</span></span>
      </h1>
    </div>
    <div class="hero-rest">
      <div class="hero-actions">
        <div class="cta-stack">
          <a class="btn btn-primary btn-lg" href={PUPPIES} data-track="hero_find_puppy">Find My Puppy <ArrowRight class="i" aria-hidden="true" /></a>
          <a class="text-link" href="#concierge" data-open-form data-track="hero_concierge">Connect with a Puppy Specialist</a>
        </div>
        <!-- PLACEHOLDER testimonial for the prototype: replace with a real, approved customer review before launch. -->
        <figure class="pullquote">
          <blockquote>“Pawrade made it easy and safe. Our specialist answered every question, and our puppy arrived healthy, happy and ready to be loved.”</blockquote>
          <figcaption><span class="stars" role="img" aria-label="5 out of 5 stars">{[0,1,2,3,4].map(() => <Star />)}</span> Pawrade customer</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<!-- ================= PUPPY SPECIALIST SUPPORT + VALUE PROPS ================= -->
<section class="support" aria-labelledby="h2-support">
  <div class="wrap support-grid">
    <img class="support-img reveal" src="/images/specialist-couple.webp" width="760" height="760" alt="A smiling couple with their new golden puppy" loading="lazy" decoding="async">
    <div class="support-copy reveal">
      <h2 id="h2-support">Puppy Specialist support</h2>
      <p>A real person, every step of the way. Your Puppy Specialist answers your questions, matches you with a verified breeder and plans your pickup or delivery, daily 9AM–11PM EST.</p>
      <ul class="vp" aria-label="Why families trust Pawrade">
        {trust.map(({ icon: Icon, title, text }) => (
          <li><Icon class="i" aria-hidden="true" /><strong>{title}</strong><span>{text}</span></li>
        ))}
      </ul>
      <a class="text-link" href="#concierge" data-open-form data-track="support_concierge">Connect with a Puppy Specialist</a>
    </div>
  </div>
</section>

<!-- ================= BREED PICKS (hidden unless ?breed=<slug> matches) ================= -->
<section class="breed-pick" id="breed-pick" aria-labelledby="h2-breeds" hidden>
  <div class="wrap">
    <div class="sec-head">
      <h2 id="h2-breeds">Puppies families like yours love</h2>
    </div>
    <ul class="breed-grid">
      {breeds.map((b) => (
        <li data-breed={b.slug} hidden><a class="tile" href={PUPPIES} data-track={`breed_${b.slug}`}>
          <img src={`/images/breeds/${b.slug}.webp`} width="360" height="480" alt={b.alt} loading="lazy" decoding="async">
          <span>{b.name}</span>
        </a></li>
      ))}
    </ul>
  </div>
</section>

<!-- ================= COMPARISON ================= -->
<section aria-labelledby="h2-compare">
  <div class="wrap compare-wrap">
    <div class="sec-head reveal">
      <h2 id="h2-compare">Families are choosing Pawrade more than ever</h2>
      <p>Buying a puppy online should feel safe. Here is what changes when you have someone on your side.</p>
    </div>
    <div class="reveal">
      <table class="compare">
        <caption class="sr-only">Buying with Pawrade compared with buying on your own</caption>
        <thead><tr><th scope="col" class="with">With Pawrade</th><th scope="col" class="own">On Your Own</th></tr></thead>
        <tbody>
          {compare.map(([w, o]) => (
            <tr><td class="with"><div><Check class="i" aria-hidden="true" />{w}</div></td><td class="own"><div><X class="i" aria-hidden="true" />{o}</div></td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ================= OFFER ================= -->
<section class="offer" id="offer" aria-labelledby="h2-offer">
