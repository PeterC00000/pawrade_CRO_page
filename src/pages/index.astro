---
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/caveat/700.css';
import '@fontsource-variable/montserrat/index.css';
import {
	Phone, ShieldCheck, HeartPulse, Truck, MessageCircle, Check, X, ArrowRight, Star, ChevronLeft, ChevronRight,
} from '@lucide/astro';

const PUPPIES = 'https://www.pawrade.com/puppies'; // TODO: confirm the Available Puppies URL
const PHONE = '(888) 729-8812';

const trust = [
	{ icon: ShieldCheck, title: 'Verified breeders', text: 'Background checked before they list a puppy' },
	{ icon: HeartPulse, title: 'Health guarantee', text: 'Vet-checked, vaccinated and guaranteed' },
	{ icon: Truck, title: 'Safe pickup or delivery', text: 'Wherever you call home' },
	{ icon: MessageCircle, title: 'Concierge support', text: 'A real person, every step of the way' },
];

const compare = [
	['No scams, full protection', 'Higher risk of scams and fraud'],
	['Quick, honest responses', 'Slower, inconsistent replies'],
	['Fully vetted breeders', 'Backyard breeders and puppy mills'],
	['Support throughout the process', 'Stuck with your gut feeling'],
];

// Popular breeds, ordered best seller to slowest. A breed shows once it has a photo in public/images/breeds/.
// To add one: drop <img>.webp (360x480) in that folder and set `img` below.
const breedsRanked = [
	{ name: 'Mini Dachshunds', img: 'mini-dachshund', alt: 'A Mini Dachshund puppy sitting in a red wagon' },
	{ name: 'Chihuahuas', img: 'chihuahua', alt: 'A tiny Chihuahua puppy held in a hand' },
	{ name: 'Cavalier King Charles Spaniels', img: 'cavalier', alt: 'A Cavalier King Charles Spaniel puppy on the grass' },
	{ name: 'Yorkshire Terriers', img: 'yorkie', alt: 'A Yorkshire Terrier puppy standing beside a plant' },
	{ name: 'Cavapoos', img: 'cavapoo', alt: 'A Cavapoo puppy sitting on a blanket' },
	{ name: 'French Bulldogs', img: 'french-bulldog', alt: 'A French Bulldog puppy with blue eyes' },
	{ name: 'Shih Tzus', img: 'shih-tzu', alt: 'A brown and white Shih Tzu puppy held in a hand' },
	{ name: 'Maltipoos', img: 'maltipoo', alt: 'A white Maltipoo puppy with a pink bow' },
	{ name: 'Mini Bernedoodles', img: 'mini-bernedoodle', alt: 'A tricolor Mini Bernedoodle puppy' },
	{ name: 'Mini Goldendoodles', img: 'mini-goldendoodle', alt: 'A curly Mini Goldendoodle puppy on a porch' },
	{ name: 'Golden Retrievers', img: 'golden-retriever', alt: 'A Golden Retriever puppy' },
	{ name: 'Toy Poodles', img: null },
	{ name: 'Pomeranians', img: 'pomeranian', alt: 'A fluffy orange Pomeranian puppy' },
	{ name: 'Havanese', img: 'havanese', alt: 'A fluffy Havanese puppy looking at the camera' },
	{ name: 'Labrador Retrievers', img: 'labrador', alt: 'A chocolate Labrador Retriever puppy with blue eyes' },
	{ name: 'Beagles', img: 'beagle', alt: 'A Beagle puppy with floppy ears' },
	{ name: 'Miniature Poodles', img: 'miniature-poodle', alt: 'A curly Miniature Poodle puppy up close' },
	{ name: 'Boston Terriers', img: 'boston-terrier', alt: 'A Boston Terrier puppy sitting in a basket' },
	{ name: 'Boxers', img: 'boxer', alt: 'A Boxer puppy sitting up' },
];
const breeds = breedsRanked.filter((b) => b.img).map((b) => ({ ...b, href: PUPPIES }));

const reviews = [
	{ img: 'rev-bart.jpg', w: 103, h: 180, alt: 'Natalie holding Bart, her Shih Tzu puppy', quote: 'Reliable service, quick response, good communication, clear instructions, healthy adorable puppy. Would recommend!', pup: 'Bart the Shih Tzu', who: 'Natalie O.' },
	{ img: 'rev-penelope.jpg', w: 103, h: 179, alt: 'Gregg holding Penelope, his Golden Retriever puppy', quote: 'I was blown away by how easy the process was. I would absolutely use them again and recommend them to friends and family.', pup: 'Penelope the Golden Retriever', who: 'Gregg L.' },
	{ img: 'rev-lucas.jpg', w: 276, h: 322, alt: 'Teena holding Lucas, her Golden Retriever puppy, after delivery', quote: 'Delivered me the most amazing puppy. He was well taken care of on the trip from Indiana to Alabama and when he got here he was happy and healthy!', pup: 'Lucas the Golden Retriever', who: 'Teena M., Auburn, AL' },
	{ img: 'rev-bruiser.jpg', w: 191, h: 295, alt: 'Vivian and her husband holding Bruiser, their Beagle puppy', quote: 'They responded to any inquiry and that included weekends. The pampered pup delivery service individuals were very caring.', pup: 'Bruiser the Beagle', who: 'Vivian R., New Providence, NJ' },
];

const steps = [
	['Tell us what you’re looking for', 'Browse available puppies, or call or message a concierge. We read every message, daily 9AM–11PM EST.'],
	['Meet your breeder match', 'We connect you with a background-checked, verified breeder and answer your questions along the way.'],
	['Bring your puppy home', 'Safe pickup or delivery, backed by the Pawrade Health Guarantee.'],
];

const pledges = [
	['Health Guarantee', 'Making the commitment to add a furry friend does not end when you get home. As fellow puppy owners, we know the importance of having a happy and healthy puppy.'],
	['No Puppy Mill Pledge', 'We have zero tolerance toward puppy mills and pride ourselves in connecting you with honest and reputable breeders where puppies are raised with love and compassion.'],
	['Safe Journey Home', 'No matter where you are located, we do our best to ensure your puppy has as close to an enjoyable and stress-free experience as possible.'],
];

const faq = [
	{ q: 'How do I know a breeder is legitimate?', a: 'Every breeder on Pawrade is background checked and verified before they can list a puppy. That is the difference between a vetted marketplace and an anonymous classified ad.' },
	{ q: 'Do you offer financing?', a: 'Yes. Flexible financing is available through our lending partner, so you can bring your puppy home now and pay over time. Terms vary by state and lender approval, and a Puppy Specialist can walk you through your options.' },
	{ q: 'Is my payment protected?', a: 'Yes. Pawrade offers protected payments, and we do not work with puppy mills.' },
	{ q: 'Can you deliver my puppy?', a: 'Safe pickup or delivery is available wherever you live. A concierge will walk you through the options for your location.' },
	{ q: 'How does the $200 offer work?', a: 'For a limited time, you take $200 off the advertised price of any puppy.', link: { href: '#offer-terms', text: 'See the offer terms' } },
];

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{ '@type': 'Organization', name: 'Pawrade', url: 'https://www.pawrade.com', telephone: '+1-888-729-8812' },
		{ '@type': 'FAQPage', mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
	],
};
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Find a Healthy Puppy from a Verified Breeder | Pawrade</title>
<meta name="description" content="Find a healthy puppy from a verified breeder. No scams, no puppy mills. Health guarantee, safe delivery and a real concierge. Save $200 for a limited time.">
<!-- PROTOTYPE: remove the robots tag below before launch if this page should be indexed. Most paid landing pages stay noindex. -->
<meta name="robots" content="noindex, nofollow">
<meta property="og:type" content="website">
<meta property="og:title" content="Find a Healthy Puppy from a Verified Breeder | Pawrade">
<meta property="og:description" content="No scams. No puppy mills. Verified breeders, a health guarantee and a real concierge. $200 off any puppy for a limited time.">
<meta property="og:image" content="/images/hero-family.jpg">
<meta property="fb:app_id" content="436584587155125">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#007dab">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" as="image" href="/images/hero-family.webp" type="image/webp" fetchpriority="high">
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>

<body>
<a class="sr-only skip" href="#main-content">Skip to main content</a>

<div class="promo" role="region" aria-label="Current offer">
  <span class="long">Fall in love with a new best friend: <strong>$200 off the advertised price of any puppy</strong>. Limited time only. </span>
  <span class="short"><strong>Fall in Love: $200 off any puppy.</strong> Limited time. </span>
  <a href="#offer-terms">See terms</a>
</div>

<header class="top">
  <div class="wrap">
    <a class="logo" href="#top" aria-label="Pawrade home"><img src="/images/logo.webp" width="454" height="91" alt="Pawrade"></a>
    <div class="top-actions">
      <a class="top-call" href="tel:8887298812" data-track="header_call">
        <small>Talk to a real person, 9AM–11PM EST</small>
        <strong>{PHONE}</strong>
      </a>
      <a class="btn btn-ghost btn-sm btn-call-m" href="tel:8887298812" data-track="header_call_mobile"><Phone class="i" aria-hidden="true" />Call us</a>
      <a class="btn btn-primary btn-sm btn-find" href={PUPPIES} data-track="header_find_puppy">Find My Puppy</a>
    </div>
  </div>
</header>

<main id="main-content">

<!-- ================= HERO ================= -->
<section class="hero" id="top" aria-labelledby="h1">
  <div class="hero-media">
    <img class="bg" src="/images/hero-family.webp" width="814" height="628" alt="A mother and her son laughing with a new puppy among autumn leaves" fetchpriority="high" loading="eager">
    <div class="offer-card">
      <div class="v">$200 off any puppy</div>
      <div class="n">Off the advertised price. Limited time only.</div>
    </div>
  </div>
  <div class="wrap hero-grid">
    <div class="hero-head">
      <h1 id="h1">Find a Healthy Puppy from a <em>Verified Breeder.</em> <span class="hand">No Scams. No Puppy Mills.</span></h1>
    </div>
    <div class="hero-rest">

      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href={PUPPIES} data-track="hero_find_puppy">Find My Puppy <ArrowRight class="i" aria-hidden="true" /></a>
        <button class="link-btn" type="button" data-open-form data-track="hero_concierge">Connect with a Puppy Specialist</button>
      </div>

      <div class="proof">
        <a href="https://www.trustpilot.com/review/pawrade.com" target="_blank" rel="noopener noreferrer" data-track="proof_trustpilot">
          <span class="stars" aria-hidden="true">{[0,1,2,3,4].map(() => <Star />)}</span>
          <span class="t"><b>7,470</b> reviews on Trustpilot</span>
        </a>
        <a href="https://www.pawrade.com/reviews/" target="_blank" rel="noopener noreferrer" data-track="proof_site_reviews">
          <span class="stars" aria-hidden="true">{[0,1,2,3,4].map(() => <Star />)}</span>
          <span class="t"><b>18,917</b> reviews on Pawrade.com</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ================= TRUST STRIP ================= -->
<div class="trust">
  <div class="wrap">
    <ul aria-label="Why families trust Pawrade">
      {trust.map(({ icon: Icon, title, text }) => (
        <li><Icon class="i" aria-hidden="true" /><div><strong>{title}</strong><span>{text}</span></div></li>
      ))}
    </ul>
  </div>
</div>

<!-- ================= BREED COLLECTIONS ================= -->
<section class="rail" aria-labelledby="h2-breeds">
  <div class="wrap">
  <!-- Popular breeds: one compact row -->
  <div class="block breeds" data-rail>
    <div class="rail-top">
      <div class="sec-head reveal">
        <h2 id="h2-breeds">Top breeds picked by people just like you</h2>
      </div>
      <div class="rail-btns">
        <button class="rail-btn" type="button" data-prev aria-label="Previous breeds"><ChevronLeft class="i" aria-hidden="true" /></button>
        <button class="rail-btn" type="button" data-next aria-label="Next breeds"><ChevronRight class="i" aria-hidden="true" /></button>
      </div>
    </div>
    <ul class="track" tabindex="0" aria-label="Popular breeds, best sellers first, scroll for more">
      {breeds.map((b) => (
        <li><a class="tile" href={b.href} data-track={`breed_${b.img}`}>
          <img src={`/images/breeds/${b.img}.webp`} width="360" height="480" alt={b.alt} loading="lazy" decoding="async">
          <span>{b.name}</span>
        </a></li>
      ))}
    </ul>
    <div class="dots" aria-hidden="true"></div>
  </div>
  </div>
</section>

<!-- ================= COMPARISON ================= -->
<section aria-labelledby="h2-compare">
  <div class="wrap compare-wrap">
    <div class="sec-head reveal">
      <h2 id="h2-compare">Families are choosing Pawrade more than ever</h2>
      <p>Buying a puppy online should feel safe. Here is what changes when you have someone on your side.</p>
    </div>
    <div class="reveal">
      <table class="compare">
        <caption class="sr-only">Buying with Pawrade compared with buying on your own</caption>
        <thead><tr><th scope="col" class="with">With Pawrade</th><th scope="col" class="own">On Your Own</th></tr></thead>
        <tbody>
          {compare.map(([w, o]) => (
            <tr><td class="with"><div><Check class="i" aria-hidden="true" />{w}</div></td><td class="own"><div><X class="i" aria-hidden="true" />{o}</div></td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ================= REVIEWS ================= -->
<section class="reviews" aria-labelledby="h2-reviews">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2 id="h2-reviews">Over 26,000 reviews from families like yours</h2>
      <div class="rev-tags">
        <a href="https://www.trustpilot.com/review/pawrade.com" target="_blank" rel="noopener noreferrer"><b>7,470</b> on Trustpilot</a>
        <a href="https://www.pawrade.com/reviews/" target="_blank" rel="noopener noreferrer"><b>18,917</b> on Pawrade.com</a>
      </div>
    </div>

    <div class="rev-grid">
      {reviews.map((r) => (
        <article class="rev reveal">
          <img src={`/images/${r.img}`} width={r.w} height={r.h} alt={r.alt} loading="lazy" decoding="async">
          <div class="b">
            <span class="stars" role="img" aria-label="5 out of 5 stars">{[0,1,2,3,4].map(() => <Star />)}</span>
            <blockquote>“{r.quote}”</blockquote>
            <cite><b>{r.pup}</b> with {r.who}</cite>
          </div>
        </article>
      ))}
    </div>
    <p class="read-more"><a href="https://www.pawrade.com/reviews/" target="_blank" rel="noopener noreferrer">Read more reviews</a></p>
  </div>
</section>

<!-- ================= OFFER ================= -->
<section class="offer" id="offer" aria-labelledby="h2-offer">
  <div class="grid">
    <img src="/images/gsd-pumpkin.webp" width="1200" height="628" alt="A German Shepherd puppy resting on a pumpkin in fallen leaves" loading="lazy" decoding="async">
    <div class="copy reveal">
      <h2 id="h2-offer">Take $200 off the advertised price of any puppy</h2>
      <p>The leaves are turning and the right puppy is out there. Browse available puppies and the savings come with your match.</p>
      <a class="btn btn-primary btn-lg" href={PUPPIES} data-track="offer_find_puppy">Find My Puppy <ArrowRight class="i" aria-hidden="true" /></a>
      <p class="terms" id="offer-terms">Limited-time offer. Applies to the advertised price of any puppy. <a href="https://www.pawrade.com/" target="_blank" rel="noopener noreferrer">See full terms</a>.</p>
    </div>
  </div>
</section>

<!-- ================= HOW IT WORKS ================= -->
<section class="how" aria-labelledby="h2-how">
  <div class="wrap grid">
    <img class="reveal" src="/images/walk.webp" width="777" height="628" alt="A woman walking a new puppy on a leash along an autumn path" loading="lazy" decoding="async">
    <div class="reveal">
      <div class="sec-head" style="margin-bottom:30px">
        <h2 id="h2-how">From first message to Gotcha day</h2>
      </div>
      <ol class="steps">
        {steps.map(([t, p]) => <li><h3>{t}</h3><p>{p}</p></li>)}
      </ol>
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href={PUPPIES} data-track="how_find_puppy">Find My Puppy <ArrowRight class="i" aria-hidden="true" /></a>
        <button class="link-btn" type="button" data-open-form data-track="how_concierge">Connect with a Puppy Specialist</button>
      </div>
    </div>
  </div>
</section>

<!-- ================= GUARANTEE ================= -->
<section class="promise" aria-labelledby="h2-promise">
  <div class="wrap grid">
    <div class="reveal">
      <h2 id="h2-promise">From reputable breeders to loving homes</h2>
      <div class="pledges">
        {pledges.map(([t, p]) => <article><h3>{t}</h3><p>{p}</p></article>)}
      </div>
      <a class="more" href="https://www.pawrade.com/" target="_blank" rel="noopener noreferrer">Read the full Health Guarantee</a>
    </div>
    <div class="promise-media reveal">
      <img class="ph" src="/images/leaves-girl.webp" width="1200" height="628" alt="A smiling girl crouching in autumn leaves with her new puppy" loading="lazy" decoding="async">
    </div>
  </div>
</section>

<!-- ================= FAQ ================= -->
<section class="faq" aria-labelledby="h2-faq">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2 id="h2-faq">Good questions to ask before you buy</h2>
    </div>
    <div class="list reveal">
      {faq.map(({ q, a, link }) => (
        <details>
          <summary>{q}<span class="pm" aria-hidden="true"></span></summary>
          <div class="ans">{a}{link && <> <a href={link.href} {...(link.ext ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{link.text}</a>.</>}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- ================= FINAL CTA ================= -->
<section class="final" aria-labelledby="h2-final">
  <div class="wrap">
    <div class="card reveal">
      <div class="copy">
        <h2 id="h2-final">Your perfect puppy is waiting</h2>
        <p>Browse vet-checked puppies from verified breeders, and save $200 for a limited time.</p>
        <div class="cta-row">
          <a class="btn btn-dark btn-lg" href={PUPPIES} data-track="final_find_puppy">Find My Puppy <ArrowRight class="i" aria-hidden="true" /></a>
          <button class="link-btn" type="button" data-open-form data-track="final_concierge">Connect with a Puppy Specialist</button>
        </div>
        <p class="phone-line">Or call <a href="tel:8887298812" data-track="final_call">{PHONE}</a>, daily 9AM–11PM EST</p>
      </div>
      <img src="/images/corgi.webp" width="1200" height="628" alt="A little girl in a red jacket hugging a corgi puppy on a log" loading="lazy" decoding="async">
    </div>
  </div>
</section>

</main>

<footer>
  <div class="wrap">
    <div>
      <img src="/images/logo-white.webp" width="600" height="120" alt="Pawrade">
      <p style="margin-top:14px">Call <a href="tel:8887298812">{PHONE}</a><br>Daily 9AM–11PM EST</p>
    </div>
    <ul>
      <li><a href="https://www.pawrade.com/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a></li>
      <li><a href="https://www.pawrade.com/terms" target="_blank" rel="noopener noreferrer">Terms of Service</a></li>
      <li><a href="https://www.pawrade.com/" target="_blank" rel="noopener noreferrer">Health Guarantee</a></li>
    </ul>
    <p class="fine">© 2026 Pawrade. Offer applies to the advertised price of any puppy, for a limited time.</p>
  </div>
</footer>

<!-- Mobile sticky action bar -->
<div class="mbar" role="region" aria-label="Quick actions">
  <a class="btn btn-primary" href={PUPPIES} data-track="mbar_find_puppy">Find My Puppy</a>
  <button class="btn btn-ghost" type="button" data-open-form data-track="mbar_concierge"><MessageCircle class="i" aria-hidden="true" />Message us</button>
</div>

<!-- ================= CONCIERGE FORM (markup follows pawrade.com contact form) ================= -->
<dialog id="concierge" aria-labelledby="cs-title">
  <div class="cs-form-card cs-form">
    <div class="cs-form-head">
      <div class="cs-form-head-title" id="cs-title">Connect with a Puppy Specialist</div>
      <p class="cs-sub">We read every message, daily 9AM–11PM EST.</p>
      <button class="cs-close" type="button" aria-label="Close form" data-close-form><X class="i" aria-hidden="true" /></button>
    </div>
    <div class="cs-form-body">
      <div id="dvContact">
        <!--
          PROTOTYPE ONLY: this form does not post anywhere.
          For production, point it at the live endpoint: action="/contact/?Length=4" method="post"
          with the __RequestVerificationToken and data-ajax attributes from the site template.
        -->
        <form id="contactForm" name="contactForm" role="form" novalidate>
          <div class="cs-form-row">
            <div class="form-group">
              <label for="FirstName">First name</label>
              <input autocomplete="given-name" class="cs-input required" id="FirstName" maxlength="50" minlength="2" name="FirstName" placeholder="Jordan" type="text" required>
              <span class="err">Please enter your first name.</span>
            </div>
            <div class="form-group">
              <label for="LastName">Last name</label>
              <input autocomplete="family-name" class="cs-input required" id="LastName" maxlength="50" minlength="2" name="LastName" placeholder="Alvarez" type="text" required>
              <span class="err">Please enter your last name.</span>
            </div>
          </div>
          <div class="cs-form-row">
            <div class="form-group">
              <label for="EmailAddress">Email address</label>
              <input autocomplete="email" class="cs-input required email" id="EmailAddress" name="EmailAddress" placeholder="you@example.com" type="email" required>
              <span class="err">Please enter a valid email address.</span>
            </div>
            <div class="form-group">
              <label for="PhoneNumber">Phone number</label>
              <input autocomplete="tel" class="cs-input required phone" id="PhoneNumber" name="PhoneNumber" placeholder="(555) 555-0123" type="tel" required>
              <span class="err">Please enter a valid phone number.</span>
            </div>
          </div>
          <div class="form-group">
            <label for="csTopicSelect">What's this about?</label>
            <select class="cs-input" id="csTopicSelect" name="Topic">
              <option value="Looking for a puppy" selected>Looking for a puppy</option>
              <option value="I've reserved a puppy">I've reserved a puppy</option>
              <option value="Travel day question">Travel day question</option>
              <option value="Health or guarantee">Health or guarantee</option>
              <option value="I'm a breeder">I'm a breeder</option>
              <option value="Something else">Something else</option>
            </select>
          </div>
          <div class="form-group">
            <label for="csMessage">Message</label>
            <textarea class="cs-input required" cols="20" id="csMessage" maxlength="5000" minlength="10" name="Message" placeholder="e.g. We have two kids under 6 and a small yard. Which of your breeds fit? Or ask about a specific puppy by name." rows="4" required></textarea>
            <span class="err">Please add a short message (at least 10 characters).</span>
          </div>
          <label class="cs-consent">
            <input checked id="MarketingConsent" name="MarketingConsent" type="checkbox" value="true">
            <span>I understand and agree to receive marketing communications from Pawrade for which I may unsubscribe at any point in time.</span>
          </label>
          <button id="btnSubmit" type="submit" class="btn btn-primary btn-lg cs-btn cs-btn-solid" title="Send message">Send message</button>
          <div class="cs-form-foot">Want an answer right now? Call <a href="tel:8887298812" class="cs-link">(888) 729-8812</a>, or after hours <a href="tel:8548002400" class="cs-link">854-800-2400</a>.</div>
        </form>
        <div class="thanks" role="status" aria-live="polite" tabindex="-1">
          <h3>Thank you, your message is in.</h3>
          <p>A Puppy Concierge will reply soon. We read every message, daily 9AM–11PM EST. If it's urgent, call <a href="tel:8887298812">(888) 729-8812</a>.</p>
