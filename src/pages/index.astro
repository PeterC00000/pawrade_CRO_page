  .steps li:not(:last-child)::after{left:14px}
  .cs-form-row{grid-template-columns:1fr;gap:0}
  .cs-form-head,.cs-form-body{padding-left:20px;padding-right:20px}
  .cs-form-head{padding-right:68px}
  .mbar{display:flex;gap:10px;position:fixed;left:0;right:0;bottom:0;z-index:60;padding:10px 12px calc(10px + env(safe-area-inset-bottom));background:#fff;border-top:1px solid var(--line);box-shadow:0 -6px 20px rgba(51,65,79,.12)}
  .mbar .btn{flex:1;min-height:52px;padding:0 12px;font-size:16px}
  .mbar .btn-primary{flex:1.35}
}
.btn-call-m{display:none}

/* ===== Popular breeds (single scroll row) ===== */
.rail{background:var(--blue-tint);padding:clamp(36px,5vw,60px) 0}
.rail .sec-head{margin-bottom:22px}
.rail-top{display:flex;align-items:flex-end;justify-content:space-between;gap:16px}
.rail-btns{display:flex;gap:10px;flex:none;padding-bottom:34px}
.rail-btn{width:48px;height:48px;border-radius:50%;border:2px solid var(--blue);background:var(--blue);color:var(--on-blue);cursor:pointer;display:grid;place-items:center;transition:background-color .18s ease-out,color .18s ease-out,opacity .18s ease-out}
.rail-btn:hover:not(:disabled){background:var(--slate);border-color:var(--slate);color:#fff}
.rail-btn:disabled{opacity:.35;cursor:default}
.track{list-style:none;margin:0;padding:4px 2px 10px;display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline:2px;scrollbar-width:none;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch}
.track::-webkit-scrollbar{display:none}
@media (prefers-reduced-motion:no-preference){.track{scroll-behavior:smooth}}
.track li{flex:0 0 calc((100% - 80px)/5);min-width:190px;scroll-snap-align:start}
.rail .breeds .track li{flex-basis:calc((100% - 100px)/6);min-width:168px}
.tile{display:block;height:100%;background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;text-decoration:none;color:var(--slate);transition:transform .2s ease-out,box-shadow .2s ease-out,border-color .2s ease-out}
.tile:hover{transform:translateY(-4px);box-shadow:var(--shadow);border-color:var(--blue)}
.tile img{width:100%;aspect-ratio:4/3;object-fit:cover;background:var(--grey)}
.rail .breeds .tile img{aspect-ratio:3/4}
.tile span{display:block;padding:14px 12px;text-align:center;font:600 15.5px/1.3 var(--head)}
.dots{display:flex;justify-content:center;gap:12px;margin-top:20px}
.dots button{width:14px;height:14px;padding:0;border-radius:50%;border:0;background:#a6d9ee;cursor:pointer;position:relative}
.dots button::after{content:"";position:absolute;inset:-15px}
.dots button[aria-current="true"]{background:var(--blue);box-shadow:0 0 0 3px var(--blue-tint),0 0 0 5px var(--blue)}
@media (max-width:700px){
  .track li,.rail .breeds .track li{flex-basis:62%;min-width:0}
  .rail-btns{display:none}
  .rail-top{display:block}
}
@media (prefers-reduced-motion:reduce){.tile,.tile:hover{transition:none;transform:none}}
</style>

<script is:inline>
/* Tracking hooks: every CTA carries a data-track value (e.g. hero_find_puppy, mbar_concierge).
   Wire these to Meta Pixel / GA4 / Google Ads events in production. Not implemented yet. */
(function(){
  document.documentElement.classList.add('js');

  // Concierge dialog
  var dlg=document.getElementById('concierge'), lastBtn=null;
  document.querySelectorAll('[data-open-form]').forEach(function(b){
    b.addEventListener('click',function(){
      lastBtn=b;
      if(dlg.showModal){dlg.showModal();}else{dlg.setAttribute('open','');}
      document.body.style.overflow='hidden';
    });
  });
  function closeDlg(){ if(dlg.close){dlg.close();}else{dlg.removeAttribute('open');} }
  dlg.addEventListener('close',function(){ document.body.style.overflow=''; if(lastBtn){lastBtn.focus();} });
  dlg.querySelectorAll('[data-close-form]').forEach(function(b){b.addEventListener('click',closeDlg);});
  dlg.addEventListener('click',function(e){ if(e.target===dlg){closeDlg();} }); // click on backdrop

  // Mock form validation + success state
  var form=document.getElementById('contactForm');
  var rules={
    FirstName:function(v){return v.trim().length>=2;},
    LastName:function(v){return v.trim().length>=2;},
    EmailAddress:function(v){return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v.trim());},
    PhoneNumber:function(v){return v.replace(/\D/g,'').length>=10;},
    Message:function(v){return v.trim().length>=10;}
  };
  form.addEventListener('submit',function(e){
    e.preventDefault();
    var firstBad=null;
    Object.keys(rules).forEach(function(n){
      var el=form.elements[n], ok=rules[n](el.value);
      el.setAttribute('aria-invalid',ok?'false':'true');
      if(!ok && !firstBad){firstBad=el;}
    });
    if(firstBad){firstBad.focus();return;}
    document.getElementById('dvContact').classList.add('is-sent');
    dlg.querySelector('.thanks').focus();
  });
  form.addEventListener('input',function(e){ if(e.target.getAttribute('aria-invalid')==='true' && rules[e.target.name] && rules[e.target.name](e.target.value)){e.target.setAttribute('aria-invalid','false');} });

  // Reveal on scroll (CSS only animates when the user has not asked for reduced motion)
  var els=document.querySelectorAll('.reveal');
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(en){ if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target);} });
    },{rootMargin:'0px 0px -8% 0px',threshold:.08});
    els.forEach(function(el){io.observe(el);});
  }else{ els.forEach(function(el){el.classList.add('in');}); }

  // Scroll lists: prev/next buttons, page dots, edge-aware disabled state
  document.querySelectorAll('[data-rail]').forEach(function(rail){
    var track=rail.querySelector('.track'), dots=rail.querySelector('.dots');
    var prev=rail.querySelector('[data-prev]'), next=rail.querySelector('[data-next]');
    var pages=1;
    function build(){
      pages=Math.max(1,Math.round(track.scrollWidth/track.clientWidth));
      dots.innerHTML='';
      if(pages<2){dots.hidden=true;return;}
      dots.hidden=false;
      for(var i=0;i<pages;i++){
        (function(i){
          var d=document.createElement('button');
          d.type='button'; d.setAttribute('aria-label','Go to page '+(i+1));
          d.addEventListener('click',function(){
            track.scrollTo({left:(track.scrollWidth-track.clientWidth)*(i/(pages-1))});
          });
          dots.appendChild(d);
        })(i);
      }
      dots.removeAttribute('aria-hidden');
      update();
    }
    function update(){
      var max=track.scrollWidth-track.clientWidth;
      var i=max>0?Math.round(track.scrollLeft/max*(pages-1)):0;
      Array.prototype.forEach.call(dots.children,function(d,n){ if(n===i){d.setAttribute('aria-current','true');}else{d.removeAttribute('aria-current');} });
      if(prev){prev.disabled=track.scrollLeft<=2;}
      if(next){next.disabled=track.scrollLeft>=max-2;}
    }
    function step(dir){ track.scrollBy({left:dir*track.clientWidth*.85}); }
    if(prev){prev.addEventListener('click',function(){step(-1);});}
    if(next){next.addEventListener('click',function(){step(1);});}
    track.addEventListener('scroll',function(){window.requestAnimationFrame(update);},{passive:true});
    window.addEventListener('resize',build);
    build();
  });
})();
</script>
</body>
</html>
