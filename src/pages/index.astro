<!doctype html>
<html lang="en" data-v="pmax">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Find a Healthy Puppy from a Verified Breeder | Pawrade</title>
<meta name="description" content="Find a healthy puppy from a verified breeder. Zero scams, zero puppy mills. Health guarantee and safe delivery from breeders across the US. Save $200 for a limited time.">
<!-- PROTOTYPE: remove the robots tag below before launch if this page should be indexed. Most paid landing pages stay noindex. -->
<meta name="robots" content="noindex, nofollow">
<meta property="og:type" content="website">
<meta property="og:title" content="Find a Healthy Puppy from a Verified Breeder | Pawrade">
<meta property="og:description" content="Zero scams. Zero puppy mills. Verified breeders, a health guarantee and safe delivery across the US. $200 off any puppy for a limited time.">
<meta property="og:image" content="/images/hero-family.jpg">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#00a7e1">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<script is:inline>
/* Hero variant from the URL: ?v=meta (emotional, family photo) or ?v=pmax (trust + $200 offer, the default). */
(function(){
  var v=new URLSearchParams(location.search).get('v');
  v=(v==='meta')?'meta':'pmax';
  document.documentElement.setAttribute('data-v',v);
  window.PAWRADE_VARIANT=v;
  var l=document.createElement('link');
  l.rel='preload';l.as='image';l.type='image/webp';
  l.href=(v==='meta')?'/images/hero-family-meta.webp':'/images/hero-family.webp';
  document.head.appendChild(l);
})();
</script>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>

<body>
<a class="sr-only skip" href="#main-content">Skip to main content</a>

<div class="promo" role="region" aria-label="Current offer">
  <span class="long">Fall in love with a new best friend: <strong>$200 off the advertised price of any puppy</strong>. Limited time only. </span>
  <span class="short"><strong>Fall in Love: $200 off any puppy.</strong> Limited time. </span>
  <a href="#offer-terms">See terms</a>
</div>

<header class="top">
  <div class="wrap">
    <div class="logo"><img src="/images/logo.webp" width="454" height="91" alt="Pawrade"></div>
    <div class="rating" aria-label="Rated 5 out of 5 stars from over 26,000 reviews">
      <span class="stars" aria-hidden="true">{[0,1,2,3,4].map(() => <Star />)}</span>
      <span><b>26,000+</b> reviews</span>
    </div>
    <div class="top-actions">
      <a class="top-call" href="tel:8887298812" data-track="header_call">
        <small>Talk to a real person, 9AM–11PM EST</small>
        <strong>{PHONE}</strong>
      </a>
      <a class="btn btn-ghost btn-sm btn-call-m" href="tel:8887298812" data-track="header_call_mobile"><Phone class="i" aria-hidden="true" />Call us</a>
      <a class="btn btn-primary btn-sm btn-find" href={PUPPIES} data-track="header_find_puppy">Find My Puppy</a>
    </div>
  </div>
</header>

<main id="main-content">

<!-- ================= HERO (breed picker idea from slide 4a; variants via ?v=) ================= -->
<section class="hero" id="top" aria-labelledby="h1">
  <div class="hero-media" role="img" aria-label="A family laughing with their new puppy">
    <div class="bg"></div>
    <!-- PLACEHOLDER testimonial for the prototype: replace with a real, approved customer review before launch. -->
    <figure class="offer-card quote-card">
      <span class="stars" role="img" aria-label="5 out of 5 stars">{[0,1,2,3,4].map(() => <Star />)}</span>
      <blockquote>“Pawrade made it easy and safe. Our specialist answered every question, and our puppy arrived healthy, happy and ready to be loved.”</blockquote>
      <figcaption>New Puppy Parent</figcaption>
    </figure>
  </div>
  <div class="wrap hero-grid">
    <div class="hero-head">
      <h1 id="h1">
        <span class="v-pmax">Find a Healthy Puppy from a <em>Verified Breeder.</em> <span class="hand">Checked for health. Raised for happiness.</span></span>
        <span class="v-meta">Bring Home the Newest <em>Member of Your Family.</em> <span class="hand">Healthy. Happy. Yours.</span></span>
      </h1>
      <p class="sub">Backed by a health guarantee and support from first click to first cuddle.</p>
    </div>
    <div class="hero-rest">
      <div class="hero-actions">
        <div class="cta-stack">
          <a class="btn btn-white btn-lg hero-cta" href={PUPPIES} data-track="hero_find_puppy">Find My Puppy <ArrowRight class="i" aria-hidden="true" /></a>
          <a class="text-link" href="#concierge" data-open-form data-track="hero_concierge">Connect with a Puppy Specialist</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= COMPARISON ================= -->
<section aria-labelledby="h2-compare">
  <div class="wrap compare-wrap">
    <div class="sec-head reveal">
      <h2 id="h2-compare">Families are choosing Pawrade more than ever</h2>
      <p>Buying a puppy online should feel safe. Here is what changes when you have someone on your side.</p>
    </div>
    <div class="reveal">
      <table class="compare">
        <caption class="sr-only">Buying with Pawrade compared with buying on your own</caption>
        <thead><tr><th scope="col" class="with">With Pawrade</th><th scope="col" class="own">On Your Own</th></tr></thead>
        <tbody>
          {compare.map(([w, o]) => (
            <tr><td class="with"><div><Check class="i" aria-hidden="true" />{w}</div></td><td class="own"><div><X class="i" aria-hidden="true" />{o}</div></td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ================= BREEDERS ACROSS THE US + DELIVERY OPTIONS ================= -->
<section class="deliv" id="delivery" aria-labelledby="h2-delivery">
  <div class="wrap deliv-grid">
    <div class="deliv-copy reveal">
      <h2 id="h2-delivery">Breeders across the US. Brought home your way.</h2>
      <p>Find your puppy from approved breeders across the country. Every delivery is handled by trusted, licensed transporters, so your puppy gets home safely, wherever you live.</p>
      <ul class="opts" aria-label="Delivery options">
        {delivery.map(({ icon: Icon, title, text }) => (
          <li><Icon class="i" aria-hidden="true" /><div><strong>{title}</strong><span>{text}</span></div></li>
        ))}
      </ul>
    </div>
    <div class="mapcard reveal" role="group" aria-label="Map of the United States with puppies from breeders across the country">
      <div class="us">
        <img class="usmap" src="/images/us-map.webp" width="1400" height="764" alt="" loading="lazy" decoding="async">
        <svg class="uslines" viewBox="0 0 1000 700" preserveAspectRatio="none" aria-hidden="true">
          {pins.map((p) => <line x1={p.sx.toFixed(1)} y1={p.sy.toFixed(1)} x2={p.tx.toFixed(1)} y2={p.ty.toFixed(1)} />)}
          {pins.map((p) => <circle cx={p.tx.toFixed(1)} cy={p.ty.toFixed(1)} r="5" />)}
        </svg>
        {pins.map((p) => (
          <figure class="pinw" style={`left:${((p.cx - p.r) / 10).toFixed(2)}%;top:${((p.cy - p.r) / 7).toFixed(2)}%;width:${(p.r * 2 / 10).toFixed(2)}%`}>
            <img class="pin" src={`/images/${p.img}.webp`} width="240" height="240" alt={`${p.alt}, ${p.city}`} loading="lazy" decoding="async">
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ================= THEY FOUND THEIRS ON PAWRADE: reviews + customer photos as an overlaid collage ================= -->
<section class="found" aria-labelledby="h2-found">
  <div class="wrap found-grid">
    <div class="found-copy reveal">
      <h2 id="h2-found">They found theirs on Pawrade.</h2>
      <p>Over 26,000 reviews from families like yours. Real families, real puppies, matched with verified breeders.</p>
      <a class="btn btn-outline btn-lg" href={PUPPIES} data-track="found_view_puppies">View Available Puppies <ArrowRight class="i" aria-hidden="true" /></a>
    </div>
    <div class="collage reveal">
      {reviews.map((r, i) => (
        <>
          <figure class={`ph ph${i + 1}`}><img src={r.photo} width="640" height={r.ph} alt={r.alt} loading="lazy" decoding="async"></figure>
          <article class={`rcard rc${i + 1}`}>
            <span class="stars" role="img" aria-label="5 out of 5 stars">{[0,1,2,3,4].map(() => <Star />)}</span>
            <div class="pup">{r.pup}</div>
            <blockquote>“{r.quote}”</blockquote>
            <cite>{r.who}</cite>
          </article>
        </>
      ))}
    </div>
  </div>
</section>

<!-- ================= OFFER ================= -->
<section class="offer" id="offer" aria-labelledby="h2-offer">
  <div class="grid">
    <div class="copy reveal">
      <h2 id="h2-offer">Save $200 on Puppy love</h2>
      <p>Take $200 off the advertised price of any puppy. The leaves are turning and the right puppy is out there. Browse available puppies and the savings come with your match.</p>
      <p class="terms" id="offer-terms">Limited-time offer. Applies to the advertised price of any puppy. <a href="https://www.pawrade.com/" target="_blank" rel="noopener noreferrer">See full terms</a>.</p>
    </div>
  </div>
</section>

<!-- ================= STILL LOOKING FOR YOUR DREAM PUPPY? (slide 15) ================= -->
<section class="dream" aria-labelledby="h2-dream">
  {bubbles.map((slug, i) => <img class={`bubble b${i + 1}`} src={`/images/breeds/${slug}.webp`} width="360" height="480" alt="" aria-hidden="true" loading="lazy" decoding="async">)}
  <div class="wrap">
    <h2 id="h2-dream">Still looking for your dream puppy?</h2>
    <p>Browse available puppies from vetted and approved breeders.</p>
    <a class="btn btn-white btn-lg" href={PUPPIES} data-track="dream_view_all">View All Puppies <ArrowRight class="i" aria-hidden="true" /></a>
    <div><a class="text-link" href="#concierge" data-open-form data-track="final_concierge">Connect with a Puppy Specialist</a></div>
  </div>
</section>

</main>

<footer>
  <div class="wrap">
    <ul>
      <li><a href="https://www.pawrade.com/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a></li>
      <li><a href="https://www.pawrade.com/terms" target="_blank" rel="noopener noreferrer">Terms of Service</a></li>
    </ul>
    <p class="fine">© 2026 Pawrade. Offer applies to the advertised price of any puppy, for a limited time.</p>
  </div>
</footer>

<!-- Mobile sticky action bar -->
<div class="mbar" role="region" aria-label="Quick actions">
  <a class="btn btn-primary" href={PUPPIES} data-track="mbar_find_puppy">Find My Puppy</a>
  <button class="btn btn-ghost" type="button" data-open-form data-track="mbar_concierge"><MessageCircle class="i" aria-hidden="true" />Message us</button>
</div>

<!-- ================= CONCIERGE FORM (markup follows pawrade.com contact form) ================= -->
<dialog id="concierge" aria-labelledby="cs-title">
  <div class="cs-form-card cs-form">
    <div class="cs-form-head">
      <div class="cs-form-head-title" id="cs-title">Connect with a Puppy Specialist</div>
      <p class="cs-sub">We read every message, daily 9AM–11PM EST.</p>
      <button class="cs-close" type="button" aria-label="Close form" data-close-form><X class="i" aria-hidden="true" /></button>
    </div>
    <div class="cs-form-body">
      <div id="dvContact">
        <!--
          PROTOTYPE ONLY: this form does not post anywhere.
          For production, point it at the live endpoint: action="/contact/?Length=4" method="post"
          with the __RequestVerificationToken and data-ajax attributes from the site template.
        -->
        <form id="contactForm" name="contactForm" role="form" novalidate>
          <div class="cs-form-row">
            <div class="form-group">
              <label for="FirstName">First name</label>
              <input autocomplete="given-name" class="cs-input required" id="FirstName" maxlength="50" minlength="2" name="FirstName" placeholder="Jordan" type="text" required>
              <span class="err">Please enter your first name.</span>
            </div>
            <div class="form-group">
              <label for="LastName">Last name</label>
              <input autocomplete="family-name" class="cs-input required" id="LastName" maxlength="50" minlength="2" name="LastName" placeholder="Alvarez" type="text" required>
              <span class="err">Please enter your last name.</span>
            </div>
          </div>
          <div class="cs-form-row">
            <div class="form-group">
              <label for="EmailAddress">Email address</label>
              <input autocomplete="email" class="cs-input required email" id="EmailAddress" name="EmailAddress" placeholder="you@example.com" type="email" required>
              <span class="err">Please enter a valid email address.</span>
            </div>
            <div class="form-group">
              <label for="PhoneNumber">Phone number</label>
              <input autocomplete="tel" class="cs-input required phone" id="PhoneNumber" name="PhoneNumber" placeholder="(555) 555-0123" type="tel" required>
              <span class="err">Please enter a valid phone number.</span>
            </div>
          </div>
          <div class="form-group">
            <label for="csMessage">Message</label>
            <textarea class="cs-input required" cols="20" id="csMessage" maxlength="5000" minlength="10" name="Message" placeholder="e.g. We have two kids under 6 and a small yard. Which of your breeds fit? Or ask about a specific puppy by name." rows="4" required></textarea>
            <span class="err">Please add a short message (at least 10 characters).</span>
          </div>
          <label class="cs-consent">
            <input checked id="MarketingConsent" name="MarketingConsent" type="checkbox" value="true">
            <span>I understand and agree to receive marketing communications from Pawrade for which I may unsubscribe at any point in time.</span>
          </label>
          <button id="btnSubmit" type="submit" class="btn btn-primary btn-lg cs-btn cs-btn-solid" title="Send message">Send message</button>
          <div class="cs-form-foot">Want an answer right now? Call <a href="tel:8887298812" class="cs-link">(888) 729-8812</a>, or after hours <a href="tel:8548002400" class="cs-link">854-800-2400</a>.</div>
        </form>
      </div>
    </div>
  </div>
</dialog>

<script is:inline>
/* Tracking hooks: every CTA carries a data-track value (e.g. hero_find_puppy, mbar_concierge).
   Wire these to Meta Pixel / GA4 / Google Ads events in production. Not implemented yet. */
(function(){
  document.documentElement.classList.add('js');

  // Concierge dialog
  var dlg=document.getElementById('concierge'), lastBtn=null;
  document.querySelectorAll('[data-open-form]').forEach(function(b){
    b.addEventListener('click',function(e){
      e.preventDefault();
      lastBtn=b;
      if(dlg.showModal){dlg.showModal();}else{dlg.setAttribute('open','');}
      document.body.style.overflow='hidden';
    });
  });
  function closeDlg(){ if(dlg.close){dlg.close();}else{dlg.removeAttribute('open');} }
  dlg.addEventListener('close',function(){ document.body.style.overflow=''; if(lastBtn){lastBtn.focus();} });
  dlg.querySelectorAll('[data-close-form]').forEach(function(b){b.addEventListener('click',closeDlg);});
  dlg.addEventListener('click',function(e){ if(e.target===dlg){closeDlg();} }); // click on backdrop

  // Mock form validation + success state
  var form=document.getElementById('contactForm');
  var rules={
    FirstName:function(v){return v.trim().length>=2;},
    LastName:function(v){return v.trim().length>=2;},
    EmailAddress:function(v){return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v.trim());},
    PhoneNumber:function(v){return v.replace(/\D/g,'').length>=10;},
    Message:function(v){return v.trim().length>=10;}
  };
  form.addEventListener('submit',function(e){
    e.preventDefault();
    var firstBad=null;
    Object.keys(rules).forEach(function(n){
      var el=form.elements[n], ok=rules[n](el.value);
      el.setAttribute('aria-invalid',ok?'false':'true');
      if(!ok && !firstBad){firstBad=el;}
    });
    if(firstBad){firstBad.focus();return;}
    window.location.assign('/thanks'+(window.PAWRADE_VARIANT?'?v='+window.PAWRADE_VARIANT:''));
  });
  form.addEventListener('input',function(e){ if(e.target.getAttribute('aria-invalid')==='true' && rules[e.target.name] && rules[e.target.name](e.target.value)){e.target.setAttribute('aria-invalid','false');} });


  // ?breed=<slug>: reveal 4-6 breed cards, the requested breed first, then top sellers
  var bp=document.getElementById('breed-pick');
  if(bp){
    var norm=function(x){return (x||'').toLowerCase().replace(/[^a-z0-9]/g,'');};
    var want=norm(new URLSearchParams(location.search).get('breed'));
    var cards=[].slice.call(bp.querySelectorAll('[data-breed]'));
    var hit=null;
    cards.forEach(function(c){
      var k=norm(c.getAttribute('data-breed'));
      if(want && (k===want || k===want.replace(/s$/,'') || k+'s'===want)){hit=c;}
    });
    if(hit){
      var list=bp.querySelector('.breed-grid');
      var picked=[hit].concat(cards.filter(function(c){return c!==hit;}).slice(0,5));
      cards.forEach(function(c){c.hidden=true;});
      picked.forEach(function(c){c.hidden=false;list.appendChild(c);});
      bp.hidden=false;
    }
  }

  // Reveal on scroll (CSS only animates when the user has not asked for reduced motion)
  var els=document.querySelectorAll('.reveal');
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(en){ if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target);} });
    },{rootMargin:'0px 0px -8% 0px',threshold:.08});
    els.forEach(function(el){io.observe(el);});
  }else{ els.forEach(function(el){el.classList.add('in');}); }

})();
</script>
</body>
</html>
