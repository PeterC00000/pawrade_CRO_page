import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/caveat/700.css';
import '@fontsource-variable/montserrat/index.css';
import '../styles/landing.css';
import { Phone, ShieldCheck, HeartPulse, Truck, MessageCircle, Check, X, ArrowRight, Star } from '@lucide/astro';

const PUPPIES = 'https://www.pawrade.com/puppies'; // TODO: confirm the Available Puppies URL
const PHONE = '(888) 729-8812';

// Value-proposition boxes. They carry the Health Guarantee, No Puppy Mill Pledge and Safe Journey Home promises.
const trust = [
	{ icon: ShieldCheck, title: 'Verified breeders', text: 'Background checked, with zero tolerance for puppy mills' },
	{ icon: HeartPulse, title: 'Health guarantee', text: 'Vet-checked, vaccinated and backed by our guarantee' },
	{ icon: Truck, title: 'Safe pickup or delivery', text: 'A calm, stress-free journey home, wherever you live' },
];

const compare = [
	['No scams, full protection', 'Higher risk of scams and fraud'],
	['Quick, honest responses', 'Slower, inconsistent replies'],
	['Fully vetted breeders', 'Backyard breeders and puppy mills'],
	['Support throughout the process', 'Stuck with your gut feeling'],
];

// Shown only when the URL has ?breed=<slug> (slug = image name). Ranked best seller first.
// Add a breed by dropping <slug>.webp (360x480) into public/images/breeds/ and listing it here.
const breeds = [
	{ slug: 'mini-dachshund', name: 'Mini Dachshunds', alt: 'A Mini Dachshund puppy sitting in a red wagon' },
	{ slug: 'chihuahua', name: 'Chihuahuas', alt: 'A tiny Chihuahua puppy held in a hand' },
	{ slug: 'cavalier', name: 'Cavalier King Charles Spaniels', alt: 'A Cavalier King Charles Spaniel puppy on the grass' },
	{ slug: 'yorkie', name: 'Yorkshire Terriers', alt: 'A Yorkshire Terrier puppy standing beside a plant' },
	{ slug: 'cavapoo', name: 'Cavapoos', alt: 'A Cavapoo puppy sitting on a blanket' },
	{ slug: 'french-bulldog', name: 'French Bulldogs', alt: 'A French Bulldog puppy with blue eyes' },
	{ slug: 'shih-tzu', name: 'Shih Tzus', alt: 'A brown and white Shih Tzu puppy held in a hand' },
	{ slug: 'maltipoo', name: 'Maltipoos', alt: 'A white Maltipoo puppy with a pink bow' },
	{ slug: 'mini-bernedoodle', name: 'Mini Bernedoodles', alt: 'A tricolor Mini Bernedoodle puppy' },
	{ slug: 'mini-goldendoodle', name: 'Mini Goldendoodles', alt: 'A curly Mini Goldendoodle puppy on a porch' },
	{ slug: 'golden-retriever', name: 'Golden Retrievers', alt: 'A Golden Retriever puppy' },
	{ slug: 'pomeranian', name: 'Pomeranians', alt: 'A fluffy orange Pomeranian puppy' },
	{ slug: 'havanese', name: 'Havanese', alt: 'A fluffy Havanese puppy looking at the camera' },
	{ slug: 'labrador', name: 'Labrador Retrievers', alt: 'A chocolate Labrador Retriever puppy with blue eyes' },
	{ slug: 'beagle', name: 'Beagles', alt: 'A Beagle puppy with floppy ears' },
	{ slug: 'miniature-poodle', name: 'Miniature Poodles', alt: 'A curly Miniature Poodle puppy up close' },
	{ slug: 'boston-terrier', name: 'Boston Terriers', alt: 'A Boston Terrier puppy sitting in a basket' },
	{ slug: 'boxer', name: 'Boxers', alt: 'A Boxer puppy sitting up' },
	// Toy Poodles: add a photo, then list it here at its sales rank.
];

const reviews = [
	{ img: 'rev-bart.jpg', w: 103, h: 180, alt: 'Natalie holding Bart, her Shih Tzu puppy', quote: 'Reliable service, quick response, good communication, clear instructions, healthy adorable puppy. Would recommend!', pup: 'Bart the Shih Tzu', who: 'Natalie O.' },
	{ img: 'rev-penelope.jpg', w: 103, h: 179, alt: 'Gregg holding Penelope, his Golden Retriever puppy', quote: 'I was blown away by how easy the process was. I would absolutely use them again and recommend them to friends and family.', pup: 'Penelope the Golden Retriever', who: 'Gregg L.' },
	{ img: 'rev-lucas.jpg', w: 276, h: 322, alt: 'Teena holding Lucas, her Golden Retriever puppy, after delivery', quote: 'Delivered me the most amazing puppy. He was well taken care of on the trip from Indiana to Alabama and when he got here he was happy and healthy!', pup: 'Lucas the Golden Retriever', who: 'Teena M., Auburn, AL' },
	{ img: 'rev-bruiser.jpg', w: 191, h: 295, alt: 'Vivian and her husband holding Bruiser, their Beagle puppy', quote: 'They responded to any inquiry and that included weekends. The pampered pup delivery service individuals were very caring.', pup: 'Bruiser the Beagle', who: 'Vivian R., New Providence, NJ' },
];

const steps = [
	['Tell us what you’re looking for', 'Browse available puppies, or call or message a Puppy Specialist. We read every message, daily 9AM–11PM EST.'],
	['Meet your breeder match', 'We connect you with a background-checked, verified breeder and answer your questions along the way.'],
	['Bring your puppy home', 'Safe pickup or delivery, backed by the Pawrade Health Guarantee.'],
];

// Short FAQ. The guarantee, puppy mill pledge and safe journey promises live here and in the trust strip.
const faq = [
	{ q: 'How do I know a breeder is legitimate?', a: 'Every breeder on Pawrade is background checked and verified before they can list a puppy. We have zero tolerance for puppy mills and only work with honest, reputable breeders who raise puppies with love.' },
	{ q: 'What does the Health Guarantee cover?', a: 'Every puppy is vet-checked and vaccinated, and backed by the Pawrade Health Guarantee. The commitment doesn’t end when you get home: as fellow puppy owners, we know how much a happy, healthy puppy matters.', link: { href: 'https://www.pawrade.com/', text: 'Read the full Health Guarantee', ext: true } },
	{ q: 'Is my payment protected?', a: 'Yes. Pawrade offers protected payments, and we do not work with puppy mills.' },
	{ q: 'Can you deliver my puppy?', a: 'Safe pickup or delivery is available wherever you live. A Puppy Specialist will walk you through the options for your location, and we do our best to make the trip calm and stress-free for your puppy.' },
	{ q: 'Do you offer financing?', a: 'Yes. Flexible financing is available through our lending partner, so you can bring your puppy home now and pay over time. Terms vary by state and lender approval, and a Puppy Specialist can walk you through your options.' },
];

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{ '@type': 'Organization', name: 'Pawrade', url: 'https://www.pawrade.com', telephone: '+1-888-729-8812' },
		{ '@type': 'FAQPage', mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
	],
};
